# Copy to `.env` beside compose.yml. Both values are required; compose refuses to
# start without them rather than resolving either to an empty string.
#
# `.env` is gitignored. Nothing secret belongs in it — the broker holds no chat
# credential and no API key — but it is machine-specific.

# The public hostname this broker is served at, terminated by your reverse proxy.
# Used for the Traefik router rule and for the absolute URLs the broker prints.
HANDOFF_PUBLIC_HOST=drop.example.com

# Host directory bind-mounted at /run/handoff, where the broker creates its 0600
# control socket. Must exist as mode 0700 owned by 1000:1000 BEFORE first start:
#
#   install -d -m 700 -o 1000 -g 1000 /srv/hermes-drop/run
#   bin/install-hermes-drop.sh --preflight
#
# Point the Hermes plugin's `control_socket` at <this>/control.sock.
HANDOFF_SOCKET_DIR=/srv/hermes-drop/run
